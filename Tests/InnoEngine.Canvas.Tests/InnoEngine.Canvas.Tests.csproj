<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <CanvasScriptOutput>$([System.IO.Path]::Combine('$(MSBuildProjectExtensionsPath)', 'CanvasScripts', '$(Configuration)'))</CanvasScriptOutput>
    <CanvasEngineRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../InnoEngine'))</CanvasEngineRoot>
    <CanvasCompilerProject>$(CanvasEngineRoot)/entry/InnoEngine.Build/InnoEngine.Build.csproj</CanvasCompilerProject>
    <DotNetHost Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildToolsPath)/../../dotnet</DotNetHost>
    <DotNetHost Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildToolsPath)/../../dotnet.exe</DotNetHost>
  </PropertyGroup>
  <Import Project="$(CanvasEngineRoot)/tests/RepositoryInput.targets" />
  <ItemGroup>
    <Compile Include="*.cs" />
    <None Include="../../../InnoEngine/extern/bgfx/src/bgfx_shader.sh"
          Link="native/bgfx/includes/bgfx_shader.sh"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../InnoEngine/extern/bgfx/src/bgfx_compute.sh"
          Link="native/bgfx/includes/bgfx_compute.sh"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Inno.GameScripts">
      <HintPath>$(CanvasScriptOutput)/Inno.GameScripts.dll</HintPath>
    </Reference>
    <Reference Include="Inno.EditorScripts">
      <HintPath>$(CanvasScriptOutput)/Inno.EditorScripts.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../InnoEngine/build/distributions/Inno.Build.Distribution.Standard/Inno.Build.Distribution.Standard.csproj" />
    <ProjectReference Include="../../../InnoEngine/build/toolchains/Inno.Build.Toolchains/Inno.Build.Toolchains.csproj" />
    <ProjectReference Include="../../../InnoEngine/build/pipeline/Inno.Build/Inno.Build.csproj" />
    <ProjectReference Include="../../../InnoEngine/entry/InnoEngine.Build/InnoEngine.Build.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../InnoEngine/src/content/assets/Inno.Assets/Inno.Assets.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/content/assets/Inno.Assets.Pipeline/Inno.Assets.Pipeline.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/content/references/Inno.References/Inno.References.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/content/scene/Inno.Scene/Inno.Scene.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/content/scene/Inno.Scene.Assets/Inno.Scene.Assets.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/composition/editor/features/Inno.Editor.Assets/Inno.Editor.Assets.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/composition/editor/features/Inno.Editor.Rendering/Inno.Editor.Rendering.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/composition/editor/features/Inno.Editor.Shaders/Inno.Editor.Shaders.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/foundation/core/Inno.Core.Diagnostics/Inno.Core.Diagnostics.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/foundation/core/Inno.Core.Graphs/Inno.Core.Graphs.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/foundation/core/Inno.Core.Identity/Inno.Core.Identity.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/foundation/core/Inno.Core.Logging/Inno.Core.Logging.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/foundation/core/Inno.Core.Serialization/Inno.Core.Serialization.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/foundation/extensibility/Inno.Extensibility.Modules/Inno.Extensibility.Modules.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/foundation/extensibility/Inno.Extensibility.Types/Inno.Extensibility.Types.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/services/rendering/Inno.Rendering/Inno.Rendering.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/services/rendering/Inno.Rendering.Assets/Inno.Rendering.Assets.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/services/rendering/Inno.Rendering.Shaders/Inno.Rendering.Shaders.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/services/text/Inno.Text/Inno.Text.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/services/text/Inno.Text.Assets/Inno.Text.Assets.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/services/ui/Inno.UI/Inno.UI.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/services/ui/Inno.UI.Assets/Inno.UI.Assets.csproj" />
    <ProjectReference Include="../../../InnoEngine/backends/RmlUi/runtime/Inno.Adapter.UI.RmlUi.Authoring/Inno.Adapter.UI.RmlUi.Authoring.csproj" />
    <ProjectReference Include="../../../InnoEngine/backends/DotNet/runtime/Inno.Adapter.Modules.DotNet/Inno.Adapter.Modules.DotNet.csproj" />
    <ProjectReference Include="../../../InnoEngine/backends/DotNet/runtime/Inno.Adapter.Serialization.DotNet/Inno.Adapter.Serialization.DotNet.csproj" />
    <ProjectReference Include="../../../InnoEngine/backends/Bgfx/build/Inno.Build.Toolchains.Bgfx.Tools/Inno.Build.Toolchains.Bgfx.Tools.csproj" />
    <ProjectReference Include="../../../InnoEngine/platforms/MacOSArm64/integrations/Inno.Integration.MacOSArm64.Bgfx/Inno.Integration.MacOSArm64.Bgfx.csproj" />
  </ItemGroup>
  <Target Name="CompileCanvasProjectScripts" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="ResolveProjectReferences">
    <Error Condition="'$(CanvasToolsTarget)' == ''" Text="Canvas contract tests require an explicit CanvasToolsTarget matching the authoring tools host." />
    <MSBuild Projects="$(CanvasCompilerProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_CanvasCompiler" />
    </MSBuild>
    <Error Condition="'@(_CanvasCompiler->Count())' != '1'" Text="Canvas tests require exactly one evaluated build compiler output." />
    <Exec Command="&quot;$(DotNetHost)&quot; &quot;@(_CanvasCompiler)&quot; scripts --engine-root &quot;$(CanvasEngineRoot)&quot; --tools-target &quot;$(CanvasToolsTarget)&quot; --project &quot;$(MSBuildProjectDirectory)/../..&quot; --output &quot;$(CanvasScriptOutput)&quot; --ide" />
  </Target>
  <Target Name="CollectCanvasProjectAssets" BeforeTargets="AssignTargetPaths" DependsOnTargets="CompileCanvasProjectScripts">
    <ItemGroup>
      <_CanvasProjectAsset Include="../../Assets/**/*" Exclude="../../Assets/**/*.cs" />
      <None Include="@(_CanvasProjectAsset)"
            Link="ProjectAssets/%(_CanvasProjectAsset.RecursiveDir)%(_CanvasProjectAsset.Filename)%(_CanvasProjectAsset.Extension)"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../InnoEngine/src/services/rendering/Inno.Rendering.Assets.Authoring/Inno.Rendering.Assets.Authoring.csproj" />
    <ProjectReference Include="../../../InnoEngine/src/services/rendering/Inno.Rendering.Runtime/Inno.Rendering.Runtime.csproj" />
  </ItemGroup>
</Project>
